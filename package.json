{
  "name": "gravity",
  "version": "1.9.0",
  "private": true,
  "description": "A portable desktop agent workspace with browser connections and a built-in local API.",
  "author": "Gravity contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "electron tests/electron-smoke.mjs",
    "dist": "node scripts/package.mjs",
    "pack": "electron-builder --dir",
    "gateway": "node electron/standalone.mjs",
    "web2api": "node electron/standalone.mjs",
    "web2api:accounts": "node bridges/multi-web2api/cli.mjs start",
    "web2api:setup": "node bridges/multi-web2api/cli.mjs setup",
    "web2api:info": "node bridges/multi-web2api/cli.mjs info",
    "web2api:models": "node bridges/multi-web2api/cli.mjs models",
    "web2api:probe": "node bridges/multi-web2api/cli.mjs probe"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@thednp/dommatrix": "3.1.2",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "pdfjs-dist": "6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.0",
    "saxes": "6.0.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "0.25.12",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "dev.antigravity.studio",
    "productName": "Gravity",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "browser-extension/**/*",
      "bridges/multi-web2api/login-events.mjs",
      "package.json",
      "build/icon.ico",
      "LICENSE",
      "THIRD_PARTY.md",
      "THIRD_PARTY_LICENSES.txt",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "release/web2api-build/runtime",
        "to": "web2api/runtime"
      },
      {
        "from": "release/web2api-build/bridge",
        "to": "web2api/bridge"
      },
      {
        "from": "release/web2api-build/bridge/node_modules/playwright-core",
        "to": "web2api/bridge/node_modules/playwright-core",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "release/document-build",
        "to": "documents"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "artifactName": "Gravity-${version}-${arch}.${ext}"
  }
}
